# ==============================================================================
# Useaimly - Goal-Aware Decision Intelligence Platform Environment Variables
# "See tomorrow before deciding today"
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Useaimly
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Supabase Public Configuration (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only (Privileged / Edge functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe Payment Gateway Integration (Test & Live)
# Server-only Secret Key (Never expose to browser)
STRIPE_SECRET_KEY=sk_test_...
# Client-safe Publishable Key (Only used if Stripe.js is loaded in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook Signing Secret (From Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: Specific Stripe Price IDs (If pre-configured in Stripe Catalog)
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_ANNUAL=price_...
# Optional: Stripe Hosted Payment Links
STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/test_...
STRIPE_PAYMENT_LINK_PRO_ANNUAL=https://buy.stripe.com/test_...

# AI Provider Configuration Layer
# Supported options: 'mock' | 'openai' | 'anthropic' | 'gemini'
AI_PROVIDER=mock

# OpenAI (Optional if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Optional if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Optional if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# PayPal Payment Gateway Integration
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MERCHANT_EMAIL=herimaliyabwana@gmail.com
PAYPAL_MODE=live

# M-Pesa Paybill Configuration (Kenya)
NEXT_PUBLIC_MPESA_PAYBILL=247247
NEXT_PUBLIC_MPESA_ACCOUNT=0743898803
